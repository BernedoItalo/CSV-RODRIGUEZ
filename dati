#include <iostream>
#include <fstream>
#include <string>
using namespace std;
	struct info
	  {
	  	string classe_toponimo;
	  	string Descrizione_Toponimo;
	  	string num;
	    string subalterno;
	    string cap;
	  	int SezioneISTAT;
	  	double Lat;
	  	double Lon;
	  	string location;
	  	};
		 
struct location
{
	 double Lat;
    double Lon;

};


		 
		  ///funzione   visualizza
		  ///funzione       ordine
		  ///funzione      cerca per via
		                 

int main()
{
    info num_civica[1000];

    ifstream fileInput("Comune_Bergamo_-_Numerazione_civica.csv");

    
    if (!fileInput)
    {
        cout << "Errore apertura file!" << endl;
        return 1;
    }

    string linea;

    // Salta scritta iniziale che non centra niente
    getline(fileInput, linea);

    int d = 0;

    while (getline(fileInput, linea) && d < 1000)
    {
        stringstream ss(linea);
        string campo;

        getline(ss, num_civica[d].classe_toponimo, ',');      //////////////////////////classe_toponimo

        getline(ss, num_civica[d].Descrizione_Toponimo, ',');  //////////////////////////////Descrizione_Toponimo

        getline(ss, num_civica[d].num, ',');

        getline(ss, num_civica[d].Subalterno, ',');           //////////////////////////////////////////// subalterno

        getline(ss, num_civica[d].cap, ',');       //////////////////////////////////////////// cap

        //////////////////////////////////////////// ISTAT 
        getline(ss, campo, ',');

        if (!campo.empty())
            num_civica[d].SezioneISTAT = stoi(campo);
        else
            num_civica[d].SezioneISTAT = 0;

         //////////////////////////////////////////// Lat  
        getline(ss, campo, ',');

       
    
        if (!campo.empty())
            num_civica[d].Lat = stod(campo);
        else
            num_civica[d].Lat = 0;

        ////////////////////////////////////////////// Lon 
        getline(ss, campo, ',');

    
        if (!campo.empty())
            num_civica[d].Lon = stod(campo);
        else
              num_civica[d].Lon = 0;

         ////////////////////////////////////////////  Location 
            getline(ss, num_civica[d].location);

        d++;
    }

    fileInput.close();

    cout <<"nCaricate " << endl<<d << " righe nel vettore."<<endl;

    // Visualizza solo quelle realmente caricate
    visualizza(num_civica, d);

    return 0;
}
