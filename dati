#include <iostream>
#include <fstream>
#include <string>
#include <sstream>

using namespace std;

struct info
{
    string classe_toponimo;
    string Descrizione_Toponimo;
    string num;
    string Subalterno;
    string cap;
    int SezioneISTAT;
    double Lat;
    double Lon;
    string location;
};

struct location
{
	 double Lat;
    double Lon;

};

// FUNZIONE VISUALIZZA
void visualizza(info num_civica[], int n)
{
    for (int i = 0; i < n; i++)
    {   
        
        cout <<"nRecord " << i + 1 << endl;

        cout << "Classe toponimo: "
               << num_civica[i].classe_toponimo << endl;
         
        cout << "Descrizione: "
               << num_civica[i].Descrizione_Toponimo << endl;

        cout << "Numero: "
               << num_civica[i].num << endl;

        cout << "Subalterno: "
               << num_civica[i].Subalterno << endl;
 
        cout << "CAP: "
               << num_civica[i].cap << endl;

        cout << "Sezione ISTAT: "
               << num_civica[i].SezioneISTAT << endl;

        cout << "Latitudine: "
               << num_civica[i].Lat << endl;

        cout << "Longitudine: "
                << num_civica[i].Lon << endl;

        cout << "Location: "
               << num_civica[i].location << endl;

    
    }
}

int main()
{
    info num_civica[1000];

    ifstream fileInput("Comune_Bergamo_-_Numerazione_civica.csv");

    
    if (!fileInput)
    {
        cout << "Errore apertura file!" << endl;
        return 1;
    }

    string linea;

    // Salta intestazione
    getline(fileInput, linea);

    int d = 0;

    while (getline(fileInput, linea) && d < 1000)
    {
        stringstream ss(linea);
        string campo;

        getline(ss, num_civica[d].classe_toponimo, ',');

        getline(ss, num_civica[d].Descrizione_Toponimo, ',');

        getline(ss, num_civica[d].num, ',');

        getline(ss, num_civica[d].Subalterno, ',');

        getline(ss, num_civica[d].cap, ',');

        //////////////////////////////////////////// ISTAT 
        getline(ss, campo, ',');

        if (!campo.empty())
            num_civica[d].SezioneISTAT = stoi(campo);
        else
            num_civica[d].SezioneISTAT = 0;

         //////////////////////////////////////////// Lat  
        getline(ss, campo, ',');

       
    
        if (!campo.empty())
            num_civica[d].Lat = stod(campo);
        else
            num_civica[d].Lat = 0;

        ////////////////////////////////////////////// Lon 
        getline(ss, campo, ',');

    
        if (!campo.empty())
            num_civica[d].Lon = stod(campo);
        else
              num_civica[d].Lon = 0;

         ////////////////////////////////////////////  Location 
            getline(ss, num_civica[d].location);

        d++;
    }

    fileInput.close();

    cout <<"nCaricate " << endl<<d << " righe nel vettore."<<endl;

    // Visualizza solo quelle realmente caricate
    visualizza(num_civica,d);

    return 0;
}
