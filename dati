/////////////////////// FUNZIONE VISUALIZZA
info visualizza(info num_civica[], int i)
{
    info dato;

    dato.classe_toponimo = num_civica[i].classe_toponimo;

    dato.Descrizione_Toponimo = num_civica[i].Descrizione_Toponimo;

    dato.num = num_civica[i].num;

    dato.Subalterno = num_civica[i].Subalterno;

    dato.cap = num_civica[i].cap;

    dato.SezioneISTAT = num_civica[i].SezioneISTAT;

    dato.Lat = num_civica[i].Lat;

    dato.Lon = num_civica[i].Lon;

    dato.location = num_civica[i].location;

    return dato;
}






