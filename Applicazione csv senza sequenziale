#include <iostream>
#include <fstream>
#include <string>
#include <sstream>
#include <cstdlib>

using namespace std;

struct info
{
    string classe_toponimo;
    string Descrizione_Toponimo;
    string num;
    string Subalterno;
    string cap;
    int SezioneISTAT;
    double Lat;
    double Lon;
    string location;
};




////////////////////////////////////////////////////////////////////////////////////////////////////FUNZIONE CARICAMENTO
int caricaDati(info num_civica[])
{
    ifstream fileInput("Comune_Bergamo_-_Numerazione_civica.csv");

    if (!fileInput)
    {
        cout << "Errore apertura " << endl;
        return 0;
    }

    string linea;
    getline(fileInput, linea); // intestazione

    int d = 0;

    while (getline(fileInput, linea) && d < 1000) //mentre  legge ed d e minore di 1000
    {
        stringstream ss(linea); //permette di leggere quella riga del file e facilita il get line(file temporaneo
        string campo;

        getline(ss, num_civica[d].classe_toponimo, ','); //il , serve per capire quando il valore e quello che ci serve
        getline(ss, num_civica[d].Descrizione_Toponimo, ',');
        getline(ss, num_civica[d].num, ',');
        getline(ss, num_civica[d].Subalterno, ',');
        getline(ss, num_civica[d].cap, ',');

        getline(ss, campo, ',');
        num_civica[d].SezioneISTAT = campo.empty() ? 0 : stoi(campo);   //  stoi serve per convertire da stringa a intero 

        getline(ss, campo, ',');
        num_civica[d].Lat = campo.empty() ? 0.0 : stod(campo);      // stod serve per convertire da stringa a double

        getline(ss, campo, ',');
        num_civica[d].Lon = campo.empty() ? 0.0 : stod(campo);
                          //campo empty ? e per vedere se vuoto e in caso sia vuoto il valore e 0.0 altimenti fa la conversione mantenendo con lo stod

        getline(ss, num_civica[d].location);

        d++; //contatore
    }

    fileInput.close();

    cout << "Caricati " << d << " record." << endl;

    return d;
}

////////////////////////////////////////////////////////////////////////////////////////////////////FUNZIONE VISUALIZZA
info visualizza(info num_civica[], int i)
{
    return num_civica[i];
}

////////////////////////////////////////////////////////////////////////////////////////////////////FUNZIONE HTML
void scriviRecordHTML(info num_civica[], int d)
{
    int sezioni[1000] = {0}; //qui tutto le sezioni diverse del ISTAT
    int conteggi[1000] = {0}; //salviamo il record per ogni sezione
    int nSezioni = 0;    //numero di sezioni diverse


// Controlla se questa sezione ce gia
    for (int i = 0; i < d; i++)
    {
        int sez = num_civica[i].SezioneISTAT;
        bool trovata = false;

        for (int j = 0; j < nSezioni; j++)
        {
            if (sezioni[j] == sez)
            {
                trovata = true;
                break;                  // Esci dal ciclo interno
            }
        }

// Se non è stata trovata viene aggiunta qua
        if (!trovata)
        {
            sezioni[nSezioni] = sez;
            nSezioni++;
        }
    }


/// il secondo gruppo server per Contare quanti record appartengono a ciascuna sezione ISTAT.
    for (int i = 0; i < d; i++) //controllo di ogni ricord
    {
        int sez = num_civica[i].SezioneISTAT; //varibile di appogio  per copiare

        for (int j = 0; j < nSezioni; j++) //controllo di ogni sezione
        {
            if (sezioni[j] == sez)
            {
                conteggi[j]++;  // in caso di sezione uguale aumenta il numero di esse
                break;
            }
        }
    }

    ofstream outfile("esempio.html");

    if (!outfile)
    {
        cout << "Errore apertura file HTML" << endl;
        return;
    }

    outfile << "<html>" << endl;
    outfile << "<body>" << endl;

    outfile << "<h2>Numero di record per Sezione ISTAT</h2>" << endl; //h2 Heading tag per dare un livelo di importanza infatti e h2 cosi che il tittolo sia piu grande
  
    outfile << "<tr><th>Sezione ISTAT</th><th>Numero Record</th></tr>" << endl;  //th Table Header cella per scrivere   td table date celle normale

    for (int i = 0; i < nSezioni; i++)
    {
        outfile << "<tr><td>" << sezioni[i]
                << "</td><td>" << conteggi[i]
                << "</td></tr>" << endl;
    }

    outfile << "</table>" << endl;   //corpo del file html
    outfile << "</body>" << endl;
    outfile << "</html>" << endl; 

    outfile.close();

    cout << "Report HTML creato con successo!" << endl;
}

// ====================== CERCA VIA ======================
void cercaVia(info num_civica[], int d, string via)
{
    info trovati[1000];
    int n = 0;

    for (int i = 0; i < d; i++)
    {
        if (num_civica[i].Descrizione_Toponimo == via)
        {
            trovati[n] = num_civica[i];
            n++;
        }
    }

    if (n == 0)
    {
        cout << "Nessun record trovato per la via: " << via << endl;
        return;
    }
// sort 
    for(int j = 0; j < n - 1; j++)
    {
        for(int i = j + 1; i < n; i++)
        {
            int num1 = atoi(trovati[j].num.c_str());
            int num2 = atoi(trovati[i].num.c_str());

            if(num1 > num2)   // > per ordine crescente
            {
                info temp = trovati[j];
                trovati[j] = trovati[i];
                trovati[i] = temp;
            }
        }
    }

    cout << endl;
    cout << "Record trovati per la via:" << via << endl;
    cout << "Totale record:" << n << endl;
    cout << endl;

    for (int i = 0; i < n; i++)
    {
        cout << "NUM: " << trovati[i].num
             << " Subalterno: " << trovati[i].Subalterno
             << " CAP: " << trovati[i].cap
             << " Lat: " << trovati[i].Lat
             << " Lon: " << trovati[i].Lon << endl;
    }
}

