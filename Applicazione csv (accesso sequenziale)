void VisualizzaFile()
{
    ifstream file("Comune_Bergamo_-_Numerazione_civica.csv");
    string line;
    int cont = 0;

    cout << "\n CONTENUTO DEL FILE CSV" << endl << endl;

    while (getline(file, line)) 
    {
        cout << line << endl;
        cont++;

        // Paginazione ogni 15 righe
        if (cont % 15 == 0) 
        {
            cout << "\nPremi INVIO per continuare" << endl;
            cin.get();
        }
    }
    cout << "\nTotale record visualizzati: " << cont << endl;
}






